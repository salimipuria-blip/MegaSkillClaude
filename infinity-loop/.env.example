# Local DeepSeek endpoint (OpenAI-compatible). Leave unset to auto-detect Ollama then LM Studio.
# Ollama:    http://localhost:11434/v1   (model e.g. deepseek-r1, deepseek-coder-v2)
# LM Studio: http://localhost:1234/v1    (model = whatever you loaded)
# INFINITY_LOOP_BASE_URL=http://localhost:11434/v1
# INFINITY_LOOP_MODEL=deepseek-r1
# INFINITY_LOOP_API_KEY=not-needed
# INFINITY_LOOP_TIMEOUT_MS=120000
