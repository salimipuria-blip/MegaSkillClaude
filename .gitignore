__pycache__/
*.pyc
node_modules/

# Local secrets; sanitized examples remain versioned.
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example

# Generated local validation renders/screenshots; never source artifacts.
/build/

# claude.ai skill zips (scripts/build_claudeai_skill.py --out dist/claudeai)
dist/

# Frame dumps from brand motion renders (regenerated by render.mjs).
brands/viking-offroad/motion/*/frames/

# Generated deploy artifact (rebuild with: cd infinity-mega-skill && node tools/make_zip.mjs)
infinity-mega-skill/release/

# Live-model credentials for infinity-mega-skill/tools/live-check.mjs — never committed.
infinity-mega-skill/.infinity-key
