# Hermes production example — same keys as .env.example, production posture:
# LOG_LEVEL=info, JSON logs for collectors, telemetry off, strict env-file perms.
# Fill in the secret manager / Cloudflare dashboard, never in Git.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=
GEMINI_API_KEY=
LOG_LEVEL=info
HERMES_LOG_FORMAT=json
HERMES_ENV_STRICT=1
TELEMETRY_DISABLE=1
