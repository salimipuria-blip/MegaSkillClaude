# Hermes — example environment. Copy values into the platform's secret store
# (Cloudflare Worker Secrets for Lite, the server's Hermes config for Full).
# NEVER commit a filled-in copy. See docs/hermes/INSTALL.md.

# --- Hermes Lite (Cloudflare Worker) ---
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=
GEMINI_API_KEY=
# Optional backup brains (each used only when set):
GITHUB_MODELS_TOKEN=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOKING_PHONE=
BOOKING_ADMIN_IDS=

# --- Hermes Full installer (setup.sh, Oracle) ---
TELEGRAM_USER_ID=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# TELEGRAM_API_BASE=https://api.telegram.org
# HERMES_SECRETS_DIR=/run/secrets/hermes

# --- Shared observability ---
LOG_LEVEL=info
HERMES_LOG_FORMAT=text
TELEMETRY_DISABLE=1
