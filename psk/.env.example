# Add ONLY through Vercel > Project > Settings > Environment Variables; never commit real values.
ENGINE_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
# Optional free-tier model keys (use accounts WITHOUT billing attached). Any one is enough.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional, default OFF. PSK_TELEMETRY=1 writes one technical JSON line per routing request to
# Vercel runtime logs (Hobby keeps them ~1 hour). Never logs query text, tokens, IPs or responses.
# PSK_TELEMETRY=1
# Optional overrides. OpenRouter models must end with ":free" or the provider is refused.
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# PROVIDER_ORDER=groq,cerebras,gemini,openrouter
