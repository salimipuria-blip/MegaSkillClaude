{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "cleanUrls": true,
 "functions": {
  "api/*.js": {
   "maxDuration": 60,
   "includeFiles": "data/**"
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ],
 "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ."
}
