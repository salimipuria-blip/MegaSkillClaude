{
  "extraKnownMarketplaces": {
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "psk": {
      "source": {
        "source": "github",
        "repo": "salimipuria-blip/MegaSkillClaude"
      }
    }
  },
  "enabledPlugins": {
    "mega-skills-router@psk": true,
    "marketing-skills@marketingskills": true
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline/statusline.js\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline/record-action.js\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
